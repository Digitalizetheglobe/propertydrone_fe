{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/weblogin/layout,_N_T_/weblogin/page,_N_T_/weblogin"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/weblogin/__PAGE__",
    "/weblogin",
    "/_index",
    "/_head"
  ]
}
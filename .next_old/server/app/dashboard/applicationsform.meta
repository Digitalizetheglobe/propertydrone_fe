{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/applicationsform/layout,_N_T_/dashboard/applicationsform/page,_N_T_/dashboard/applicationsform"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/applicationsform/__PAGE__",
    "/dashboard/applicationsform",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}